# Optional Vite environment variables.
# Copy to .env for local overrides. Never commit .env or a real path.

# Optional absolute vault path for local/dev open. Never put a real machine path.
# VITE_OPEN_VAULT=

# "Created with Grok" banner. Defaults off.
VITE_SHOW_BUILT_WITH_GROK=false

# Remix link on that banner. Only used when the banner is on.
# VITE_ALLOW_FORKING=false
# VITE_PROJECT_ID=

# Public hostname for the social preview card. Leave unset for local/dev.
# VITE_PUBLIC_HOSTNAME=
