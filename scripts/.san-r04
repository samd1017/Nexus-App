 for real app testing (same shape as demo vault).\n",
    )

    # browser-smoke header + default path
    smoke = read("scripts/browser-smoke.mjs")
    smoke_old = """ * Screenshots default under /workspace/screenshots/ (never /tmp) so they live on
 * the workspace volume and stay readable by agent tools.
 *
 * Targets are restricted (browser-guard.mjs): http/https loopback, PNG under
 * /workspace. A rejected target exits 1.
"""
    smoke_new = """ * Screenshots default under gitignored artifacts/screenshots
 * (override with NEXUS_SCREENSHOT_DIR). Never a home directory.
 *
 * Targets are restricted (browser-guard.mjs): http/https loopback, PNG under
 * that screenshot directory. A rejected target exits 1.
"""
    if smoke_old not in smoke:
        sys.exit("browser-smoke comment missing")
    smoke = smoke.replace(smoke_old, smoke_new, 1)
    smoke = smoke.replace(
        'import { checkedOutputPath, checkedUrl } from "./browser-guard.mjs";\n',
        'import { checkedOutputPath, checkedUrl } from "./browser-guard.mjs";\nimport { screenshotPath, screenshotRoot } from "./screenshot-dir.mjs";\n',
        1,
    )
    smoke = smoke.replace(
        'process.argv[3] || "/workspace/screenshots/app-builder-preview.png",\n  ["/workspace"],',
        'process.argv[3] || screenshotPath("app-builder-preview.png"),\n  [screenshotRoot()],',
        1,
    )
    write("scripts/browser-smoke.mjs", smoke)

    thumb = read("scripts/preview-thumbnail.mjs")
    thumb2 = thumb.replace('  "/tmp",\n  "/workspace",\n', '  "/tmp",\n')
    if thumb2 == thumb:
        sys.exit("preview allowlist unchanged")
    write("scripts/preview-thumbnail.mjs", thumb2)

    shot_re = re.compile(r'"/workspace/screenshots/([^"]+)"')

 