   def retarget(rel, importer):
        text = read(rel)
        if "screenshot-dir.mjs" not in text:
            if importer not in text:
                sys.exit(f"importer missing in {rel}")
            text = text.replace(importer, importer + 'import { screenshotPath } from "./screenshot-dir.mjs";\n', 1)
        text2, n = shot_re.subn(lambda m: f'screenshotPath("{m.group(1)}")', text)
        if n == 0 and "screenshotPath(" not in text2:
            sys.exit(f"no screenshot paths in {rel}")
        write(rel, text2)

    retarget("scripts/qa-single-path.mjs", 'import fs from "fs";\n')
    retarget("scripts/test-large-vault.mjs", 'import { chromium } from "playwright";\n')
    retarget("scripts/test-large-vault-ui.mjs", 'import { chromium } from "playwright";\n')
    retarget("scripts/wave-c-qa.mjs", 'import fs from "fs";\n')
    retarget("scripts/wave-c-qa2.mjs", 'import fs from "fs";\n')
    retarget("scripts/wave-c-qa-final.mjs", 'import fs from "fs";\n')

    vis = read("scripts/qa-visual-folder-graph.mjs")
    if 'import { screenshotDir }' not in vis:
        vis = vis.replace(
            'import path from "node:path";\n',
            'import path from "node:path";\nimport { screenshotDir } from "./screenshot-dir.mjs";\n',
            1,
        )
    vis = vis.replace(
        'const OUT = "/workspace/screenshots/folder-graph";',
        'const OUT = screenshotDir("folder-graph");',
        1,
    )
    vis = vis.replace(
        "Screenshots under /workspace/screenshots/folder-graph/",
        "Screenshots under artifacts/screenshots/folder-graph/",
        1,
    )
    write("scripts/qa-visual-folder-graph.mjs", vis)
    print("compact-sanitize: OK")


if __name__ == "__main__":
    main()
