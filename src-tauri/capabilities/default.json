{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Nexus main window — vault FS (dialog-granted + app data), dialogs, menus",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "dialog:default",
    "dialog:allow-open",
    "opener:default",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-copy-file",
    "fs:allow-create",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$RESOURCE/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$HOME/Documents/**" },
        { "path": "$HOME/Desktop/**" },
        { "path": "$HOME/Downloads/**" },
        { "path": "$HOME/Library/Application Support/**" },
        { "path": "$HOME/.local/share/**" }
      ]
    }
  ]
}
