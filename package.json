    "test:wave-c": "node src/lib/vault/__tests__/wave-c.contract.mjs",
    "test:fixture-integrity": "node scripts/verify-large-test-vault.mjs",
    "test:partialize": "node scripts/test-partialize-policy.mjs",
    "test:overlay": "node scripts/test-large-vault-overlay.mjs",
    "test:disk-fts": "node scripts/test-disk-fts-fill.mjs",
    "test:sqlite-fill": "node scripts/test-sqlite-fill-progress.mjs",
    "test:sqlite-fill-rust": "cargo test --manifest-path src-tauri/fill-test/Cargo.toml --offline -- --nocapture || cargo test --manifest-path src-tauri/fill-test/Cargo.toml -- --nocapture",
    "test:first-open": "node scripts/test-first-open-fts.mjs",
    "test:chrome-fsa-cap": "node scripts/test-chrome-fsa-cap.mjs",
    "test:desk-node-id": "node scripts/test-desk-node-id.mjs",
    "test:desktop-fs-scope": "node scripts/test-desktop-fs-scope.mjs",
    "test:file-tree-flat": "node scripts/test-file-tree-flat.mjs",
    "soak:fsa": "node scripts/stress-fsa-search.mjs",
    "soak:fsa-open": "node scripts/stress-fsa-open.mjs",
    "soak:fsa-20k": "node scripts/stress-fsa-open.mjs http://127.0.0.1:8080/ --notes 20000 --opens 20 --inpage",
    "soak:fsa-cdp": "node scripts/stress-fsa-cdp.mjs",
    "soak:disk-fts": "node scripts/stress-disk-fts.mjs",
    "smoke": "node scripts/browser-smoke.mjs http://127.0.0.1:8080/ /workspace/screenshots/app-builder-preview.png",
    "qa:gate": "npm run typecheck && npm run bench:indexes && npm run bench:scale && npm run test:wave-c && npm run test:folder-graph && npm run test:graph-select && npm run test:graph-filters && npm run test:graph-empty && npm run test:link-index && npm run test:tree-expand && npm run test:fill-interaction && npm run test:wikilink-index && npm run test:fixture-integrity && npm run test:partialize && npm run test:overlay && npm run test:disk-fts && npm run test:sqlite-fill && npm run test:sqlite-fill-rust && npm run test:first-open && npm run test:chrome-fsa-cap && npm run test:desk-node-id && npm run test:desktop-fs-scope && npm run test:file-tree-flat && npm run test:body-archive && npm run test:snippets && npm run test:pkm && npm run test:nested-tasks",
    "test:pkm": "node src/lib/markdown/__tests__/pkm-links.mjs",
    "test:nested-tasks": "node src/lib/markdown/__tests__/nested-tasks.mjs",
    "test:folder-graph": "node src/lib/vault/__tests__/folder-graph.contract.mjs",
    "test:graph-select": "node src/lib/graph/__tests__/graph-select.contract.mjs",
    "test:graph-filters": "node src/lib/graph/__tests__/graph-filters.contract.mjs",
    "test:graph-empty": "node src/lib/graph/__tests__/graph-empty.contract.mjs",
    "test:link-index": "node src/lib/vault/__tests__/link-index.contract.mjs",
    "test:tree-expand": "node scripts/test-tree-expand.mjs",
    "test:fill-interaction": "node scripts/test-fill-interaction.mjs",
    "test:wikilink-index": "node src/lib/graph/__tests__/wikilink-index.contract.mjs",
    "test:body-archive": "node scripts/test-body-archive-lifecycle.mjs",
    "test:snippets": "node scripts/test-search-snippets.mjs"
  },
