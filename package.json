{
  "name": "nexus",
  "version": "0.1.1-alpha",
  "private": true,
  "description": "Local-first Markdown knowledge vault built for retrieval. Plain files, disposable FTS index, hybrid ranking as the product north star.",
  "license": "MIT",
  "author": "Sam",
  "repository": {
    "type": "git",
    "url": "https://github.com/samd1017/Nexus-App.git"
  },
  "keywords": [
    "notes",
    "markdown",
    "local-first",
    "knowledge-graph",
    "obsidian-alternative",
    "tauri",
    "retrieval",
    "fts5",
    "pkms"
  ],
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:desktop": "vite --config vite.desktop.config.ts --host 0.0.0.0 --port 8080 --strictPort",
    "build:desktop": "vite build --config vite.desktop.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "bench:scale": "node scripts/bench-scale.mjs",
    "bench:indexes": "node src/lib/vault/__tests__/indexes.bench.mjs",
    "bench:stress": "node scripts/bench-vault-stress.mjs --notes 50000",
    "bench:synthetic": "node scripts/bench-synthetic-vault.mjs",
    "bench:disk": "node scripts/bench-disk-vault.mjs",
    "soak:scale": "node scripts/scale-soak.mjs",
    "soak:ui": "node scripts/stress-ui-multisize.mjs",
    "gen:soak-vault": "node scripts/generate-synthetic-vault.mjs",
    "wave:e": "node scripts/wave-e-disk.mjs",
    "soak:wave-e-desktop": "node scripts/wave-e-desktop.mjs",
